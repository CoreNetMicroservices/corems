<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>CoreMs.TemplateMs.Core</RootNamespace>
  </PropertyGroup>

  <!-- Local development: ProjectReference (default) -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="$(SolutionRoot)common\src\CoreMs.Common\CoreMs.Common.csproj" />
  </ItemGroup>

  <!-- Docker/CI builds: PackageReference -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="CoreMs.Common" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Handlebars.Net" />
  </ItemGroup>

</Project>
