<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>CoreMs.UserMs.Api</RootNamespace>
    <UserSecretsId>corems-userms-dev</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CoreMs.UserMs.Core\CoreMs.UserMs.Core.csproj" />
    <ProjectReference Include="..\CoreMs.UserMs.Infrastructure\CoreMs.UserMs.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Local development: ProjectReference (default) -->
  <ItemGroup Condition="'$(UsePackageReferences)' != 'true'">
    <ProjectReference Include="$(SolutionRoot)aspire\CoreMs.ServiceDefaults\CoreMs.ServiceDefaults.csproj" />
    <ProjectReference Include="$(SolutionRoot)communication-ms\src\CoreMs.CommunicationMs.Client\CoreMs.CommunicationMs.Client.csproj" />
  </ItemGroup>

  <!-- Docker/CI builds: PackageReference -->
  <ItemGroup Condition="'$(UsePackageReferences)' == 'true'">
    <PackageReference Include="CoreMs.ServiceDefaults" />
    <PackageReference Include="CoreMs.CommunicationMs.Client" />
  </ItemGroup>

</Project>
